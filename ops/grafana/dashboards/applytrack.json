{
  "uid": "applytrack",
  "title": "ApplyTrack \u00b7 User impact",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Dashboard availability",
      "type": "stat",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "applytrack_dashboard_available",
          "refId": "A",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Dashboard failure rate",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(applytrack_http_requests_total{route=\"/api/dashboard\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(applytrack_http_requests_total{route=\"/api/dashboard\"}[5m])), 0.001)",
          "refId": "A",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Dashboard p95 latency",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(applytrack_http_request_duration_seconds_bucket{route=\"/api/dashboard\"}[5m])))",
          "refId": "A",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Request logs \u2014 expand a row and follow trace_id to Tempo",
      "type": "logs",
      "datasource": {
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=\"applytrack-api\"} |= \"http_request\"",
          "refId": "A"
        }
      ]
    }
  ]
}